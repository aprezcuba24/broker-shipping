# Copiar a `.env` en la raíz del monorepo (junto a docker-compose.yml).
# Producción (Railway / AWS / Cloudflare): ver docs/deploy_railway.md

# --- PostgreSQL: API (única conexión; no uses POSTGRES_* en la API) ---
DATABASE_URL=postgresql://broker:broker@localhost:6432/broker
# Railway (servicio API): Variable Reference al plugin, p. ej.:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Si la URL pública trae SSL: ...?sslmode=require

# --- PostgreSQL: solo Docker Compose (la API no lee estas variables) ---
POSTGRES_USER=broker
POSTGRES_PASSWORD=broker
POSTGRES_DB=broker
POSTGRES_PORT=6432

# --- Redis (Compose) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- MinIO (Compose) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_secret
# Puerto API publicado en el host. Si 9000 está ocupado (p.ej. otro nginx), usa otro
# (p.ej. 19000) y alinea AWS_ENDPOINT_URL / S3_PUBLIC_BASE_URL con el mismo puerto.
# Un mismatch (presign → :9000 mientras MinIO está en :19000) provoca 301 de nginx y
# el error CORS "Redirect is not allowed for a preflight request".
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# No configures MINIO_SERVER_URL con el puerto publicado en el host (p.ej. :19000):
# la consola hace login dentro del contenedor y fallaría con 503. Los PUT del
# browser usan AWS_ENDPOINT_URL; los redirects de consola usan MINIO_BROWSER_REDIRECT_URL
# (en docker-compose.yml).
# CORS global (Vite: 5173/5174/5175) está en docker-compose.yml (MINIO_API_CORS_ALLOW_ORIGIN
# + mc admin config set en minio-init). Tras cambiar CORS/puertos/env de MinIO:
#   docker compose up -d --force-recreate minio minio-init

# --- S3 / MinIO local (desarrollo) ---
# Credenciales alineadas con MINIO_ROOT_*. El bucket lo crea minio-init en Compose.
# El browser hace PUT directo a AWS_ENDPOINT_URL (presigned); CORS lo gestiona MinIO, no la API.
# AWS_ENDPOINT_URL debe coincidir con http://localhost:${MINIO_API_PORT}.
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio_secret
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=broker-local
S3_PUBLIC_BASE_URL=http://localhost:9000/broker-local

# --- S3 producción (AWS) ---
# Deja AWS_ENDPOINT_URL vacío y usa bucket/credenciales IAM:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=vendeya-prod
# AWS_ENDPOINT_URL=
# S3_PUBLIC_BASE_URL=https://vendeya-prod.s3.us-east-1.amazonaws.com

# --- JWT (Settings: JWT_SECRET, JWT_ALGORITHM, JWT_EXPIRE_MINUTES) ---
JWT_SECRET=change-me-in-production-use-32b-minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- Mail / SMTP (MailHog en local; SES en producción) ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
MAIL_FROM=noreply@broker.local
EMAIL_VERIFICATION_TOKEN_HOURS=24
FRONTEND_BACKOFFICE_URL=http://localhost:5173
FRONTEND_SELLER_URL=http://localhost:5174

# --- Frontends Vite (apps/*; prefijo VITE_) ---
# VITE_API_URL=http://localhost:8000
# URL de la app vendedor (backoffice: link de invitación a vendedores)
# VITE_SELLER_APP_URL=http://localhost:5174

# --- Landing Astro (apps/landing) ---
# PUBLIC_SITE_URL=https://vendeya.app

# --- Tests (opcional): nombre de la base usada por pytest ---
# POSTGRES_DB_TEST=broker_test
