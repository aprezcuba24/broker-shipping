{
  "name": "broker-monorepo",
  "private": true,
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:backoffice": "pnpm --filter @broker/backoffice dev",
    "dev:admin": "pnpm --filter @broker/admin dev",
    "dev:seller": "pnpm --filter @broker/seller dev",
    "dev:api": "cd services/api && uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
    "rpc:schema": "cd services/api && uv run python scripts/export_openapi.py",
    "rpc:client": "pnpm --filter @broker/api codegen",
    "build": "pnpm -r --filter './apps/*' run build",
    "format": "pnpm format:ts",
    "format:check": "pnpm format:ts:check",
    "format:ts": "prettier --write \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:ts:check": "prettier --check \"apps/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/*.{ts,tsx,js,jsx,json,css,md}\""
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "react": "$react",
      "react-dom": "$react-dom"
    }
  },
  "devDependencies": {
    "prettier": "^3.8.4"
  }
}
