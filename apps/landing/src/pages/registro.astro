---
import Layout from '../layouts/Layout.astro'
import {
  siteUrl,
  ogImage,
  formEmbedUrl,
  registerTitle,
  registerDescription,
  whatsappHref,
  whatsappPhoneDisplay,
} from '../data/site'
---

<Layout
  title={registerTitle}
  description={registerDescription}
  image={ogImage}
  pagePath="/registro"
  siteUrl={siteUrl}
  variant="registro"
  whatsappHref={whatsappHref}
>
  <main class="mx-auto max-w-3xl px-5 pb-16 pt-28">
    <div class="text-center">
      <p
        class="mb-4 inline-flex items-center gap-2 rounded-full border border-emerald-400/25 bg-emerald-400/[0.08] px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.18em] text-emerald-300"
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>
        Prelanzamiento
      </p>
      <h1 class="font-display text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
        {registerTitle}
      </h1>
      <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-slate-400">
        {registerDescription}
      </p>
    </div>

    <aside class="mt-8 rounded-2xl border border-emerald-500/20 bg-emerald-500/[0.06] p-5 text-center sm:p-6">
      <p class="text-sm leading-relaxed text-slate-300">
        ¿Prefieres hablar ahora? Escríbenos por WhatsApp y empezamos el contacto desde el primer momento.
      </p>
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-4 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-bold text-[#053b1a] shadow-[0_8px_24px_-6px_rgba(37,211,102,0.55)] transition hover:bg-[#2fe574]"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          ></path>
        </svg>
        Escribir por WhatsApp
        <span class="font-semibold opacity-80">· {whatsappPhoneDisplay}</span>
      </a>
    </aside>

    <div
      id="form-shell"
      class="relative mt-8 overflow-hidden rounded-2xl border border-white/10 bg-white shadow-xl shadow-black/40 ring-1 ring-white/5"
    >
      <div
        id="form-loader"
        class="absolute inset-0 z-10 flex min-h-[420px] flex-col items-center justify-center gap-4 bg-white px-6"
        role="status"
        aria-live="polite"
      >
        <span
          class="h-10 w-10 animate-spin rounded-full border-[3px] border-emerald-200 border-t-emerald-500"
          aria-hidden="true"></span>
        <p class="text-sm font-medium text-slate-600">Cargando el formulario…</p>
        <p class="max-w-xs text-center text-xs text-slate-400">
          Un momento, por favor. Si tarda demasiado, usa WhatsApp arriba.
        </p>
      </div>
      <iframe
        id="google-form"
        src={formEmbedUrl}
        title={registerTitle}
        class="block w-full border-0 opacity-0 transition-opacity duration-300"
        style="min-height: 900px;"></iframe>
    </div>

    <p class="mt-6 text-center text-xs leading-relaxed text-slate-600">
      Tus datos se envían a Google Forms y se guardan en una hoja de cálculo asociada a este proyecto. Solo
      los usamos para contactarte sobre el prelanzamiento.
    </p>
  </main>

  <script>
    const iframe = document.getElementById('google-form')
    const loader = document.getElementById('form-loader')

    function hideLoader() {
      if (!loader || !iframe) return
      loader.classList.add('pointer-events-none', 'opacity-0')
      iframe.classList.remove('opacity-0')
      iframe.classList.add('opacity-100')
      window.setTimeout(() => loader.remove(), 300)
    }

    if (iframe) {
      iframe.addEventListener('load', hideLoader)
      window.setTimeout(hideLoader, 8000)
    }
  </script>
</Layout>
