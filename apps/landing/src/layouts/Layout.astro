---
import '../styles/global.css'
import { productName, registerHref } from '../data/site'

type Props = {
  title: string
  description: string
  image?: string
  pagePath?: string
  /** Compact header for registro (back link) */
  variant?: 'landing' | 'registro'
  siteUrl: string
  whatsappHref?: string
}

const {
  title,
  description,
  image,
  pagePath = '',
  variant = 'landing',
  siteUrl,
  whatsappHref,
} = Astro.props

const ogImage = image ? `${siteUrl}${image}` : undefined
const ogUrl = pagePath ? `${siteUrl}${pagePath}` : siteUrl
const isRegistro = variant === 'registro'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#07090F] text-slate-200 antialiased">
    <header
      class="fixed inset-x-0 top-0 z-50 border-b border-white/[0.06] bg-[#07090F]/85 backdrop-blur-xl"
    >
      <div
        class:list={[
          'mx-auto flex items-center justify-between px-5 py-3',
          isRegistro ? 'max-w-3xl gap-3' : 'max-w-6xl',
        ]}
      >
        {
          isRegistro ? (
            <a href="/" class="shrink-0 text-sm text-slate-500 transition hover:text-white">
              ← {productName}
            </a>
          ) : (
            <a href="/" class="flex items-center gap-2.5">
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-emerald-400/15 font-display text-base font-extrabold text-emerald-300 ring-1 ring-emerald-400/40">
                V
              </span>
              <span class="hidden font-display text-sm font-bold tracking-wide text-white sm:inline">
                {productName}
              </span>
            </a>
          )
        }

        {
          isRegistro ? (
            <div class="flex items-center gap-2.5">
              <span class="grid h-8 w-8 place-items-center rounded-lg bg-emerald-400/15 font-display text-base font-extrabold text-emerald-300 ring-1 ring-emerald-400/40">
                V
              </span>
              <span class="hidden font-display text-sm font-bold tracking-wide text-white sm:inline">
                {productName}
              </span>
            </div>
          ) : (
            <a
              href={registerHref}
              class="rounded-full bg-emerald-400 px-4 py-2 text-sm font-bold text-emerald-950 transition hover:bg-emerald-300"
            >
              Me interesa
            </a>
          )
        }

        {
          isRegistro && whatsappHref ? (
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex shrink-0 items-center gap-1.5 rounded-full bg-[#25D366] px-3 py-2 text-xs font-bold text-[#053b1a] shadow-sm transition hover:bg-[#2fe574] sm:gap-2 sm:px-4 sm:text-sm"
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z" />
              </svg>
              <span class="sm:hidden">WhatsApp</span>
              <span class="hidden sm:inline">Escribir por WhatsApp</span>
            </a>
          ) : isRegistro ? (
            <span class="w-16 sm:w-24" aria-hidden="true" />
          ) : null
        }
      </div>
    </header>

    <slot />

    <footer class="border-t border-white/[0.06] py-8 text-center text-sm text-slate-600">
      <p>{productName} · Prelanzamiento</p>
    </footer>
  </body>
</html>
