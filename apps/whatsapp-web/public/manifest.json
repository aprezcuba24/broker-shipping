{
  "manifest_version": 3,
  "name": "Broker WhatsApp Web POC",
  "description": "POC: barra lateral en WhatsApp Web con detección del chat abierto.",
  "version": "0.0.1",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
