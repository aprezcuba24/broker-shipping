# Copiar a `.env` en esta carpeta.
# El build (`pnpm --filter @broker/facebook build`) embebe estas URLs en el bundle
# y en dist/manifest.json (host_permissions).
# Si falta una variable, se usa el `.env` de la raíz del monorepo.
# Una variable ya exportada en el shell pisa este archivo.

# Producción
VITE_API_URL=https://api.vendelo360.app
VITE_SELLER_URL=https://gestores.vendelo360.app
# Origen público de las fotos de producto (host_permissions).
VITE_CDN_URL=https://vendeya-prod.s3.us-east-1.amazonaws.com

# Local (descomenta y comenta las de arriba)
# VITE_API_URL=http://localhost:8000
# VITE_SELLER_URL=http://localhost:5174
# VITE_CDN_URL=http://localhost:19000
