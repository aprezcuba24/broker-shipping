# Copiar a `.env` en esta carpeta.
# El build (`pnpm --filter @broker/whatsapp-web build`) embebe estas URLs en el bundle
# y en dist/manifest.json (host_permissions y externally_connectable).
# Si falta una variable, se usa el `.env` de la raíz del monorepo.
# Una variable ya exportada en el shell pisa este archivo.

# Producción
VITE_API_URL=https://api.vendelo360.app
VITE_SELLER_URL=https://gestores.vendelo360.app

# Clave pública PEM (campo key del manifest). Mismo ID en Load unpacked y en la tienda.
# Ver docs/publicar_extension.md. No pegues el .pem privado.
# VITE_WHATSAPP_EXTENSION_KEY=

# Local (descomenta y comenta las de arriba)
# VITE_API_URL=http://localhost:8000
# VITE_SELLER_URL=http://localhost:5174
